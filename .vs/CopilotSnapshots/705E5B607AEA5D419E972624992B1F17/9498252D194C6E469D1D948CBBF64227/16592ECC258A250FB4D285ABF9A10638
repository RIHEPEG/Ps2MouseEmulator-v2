using System;
using System.Runtime.InteropServices;
using System.Text;
using Microsoft.Win32.SafeHandles;

namespace Wrapper111.Gui
{
    /// <summary>
    /// Небольшой клиент для взаимодействия с драйвером через CreateFile / DeviceIoControl.
    /// Вынесен P/Invoke и константы для тестируемости и повторного использования.
    /// </summary>
    public class DriverClient
    {
        const uint FILE_DEVICE_UNKNOWN = 0x00000022;
        public readonly uint IOCTL_SET_WATERMARK = (FILE_DEVICE_UNKNOWN << 16) | (0x800u << 2) | 0 | (0);
        public readonly uint IOCTL_GET_STATUS = (FILE_DEVICE_UNKNOWN << 16) | (0x801u << 2) | 2 | (0);

        const uint GENERIC_READ = 0x80000000;
        const uint GENERIC_WRITE = 0x40000000;
        const uint OPEN_EXISTING = 3;

        readonly string _devicePath;

        public DriverClient(string devicePath = "\\\\.\\Wrapper111")
        {
            _devicePath = devicePath;
        }

        [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
        static extern SafeFileHandle CreateFile(string lpFileName, uint dwDesiredAccess, uint dwShareMode,
            IntPtr lpSecurityAttributes, uint dwCreationDisposition, uint dwFlagsAndAttributes, IntPtr hTemplateFile);

        [DllImport("kernel32.dll", SetLastError = true)]
        static extern bool DeviceIoControl(SafeFileHandle hDevice, uint dwIoControlCode,
            IntPtr lpInBuffer, uint nInBufferSize, IntPtr lpOutBuffer, uint nOutBufferSize,
            out uint lpBytesReturned, IntPtr lpOverlapped);

        public bool TrySetWatermark(bool enable, out int win32Error, out string errorMessage)
        {
            win32Error = 0; errorMessage = null;
            try
            {
                using (var handle = CreateFile(_devicePath, GENERIC_READ | GENERIC_WRITE, 0, IntPtr.Zero, OPEN_EXISTING, 0, IntPtr.Zero))
                {
                    if (handle == null || handle.IsInvalid)
                    {
                        win32Error = Marshal.GetLastWin32Error();
                        errorMessage = "Driver device not found";
                        return false;
                    }

                    IntPtr buf = IntPtr.Zero;
                    try
                    {
                        buf = Marshal.AllocHGlobal(4);
                        Marshal.WriteInt32(buf, enable ? 1 : 0);
                        bool ok = DeviceIoControl(handle, IOCTL_SET_WATERMARK, buf, 4, IntPtr.Zero, 0, out uint ret, IntPtr.Zero);
                        if (!ok)
                        {
                            win32Error = Marshal.GetLastWin32Error();
                            errorMessage = "DeviceIoControl failed";
                            return false;
                        }
                        return true;
                    }
                    finally
                    {
                        if (buf != IntPtr.Zero) Marshal.FreeHGlobal(buf);
                    }
                }
            }
            catch (Exception ex)
            {
                win32Error = Marshal.GetLastWin32Error();
                errorMessage = ex.Message;
                return false;
            }
        }

        public bool TryGetStatus(out string status, out int win32Error, out string errorMessage)
        {
            status = null; win32Error = 0; errorMessage = null;
            try
            {
                using (var handle = CreateFile(_devicePath, GENERIC_READ, 0, IntPtr.Zero, OPEN_EXISTING, 0, IntPtr.Zero))
                {
                    if (handle == null || handle.IsInvalid)
                    {
                        win32Error = Marshal.GetLastWin32Error();
                        errorMessage = "Driver device not found";
                        return false;
                    }

                    IntPtr outBuf = IntPtr.Zero;
                    try
                    {
                        const int BUF_SIZE = 1024;
                        outBuf = Marshal.AllocHGlobal(BUF_SIZE);
                        bool ok = DeviceIoControl(handle, IOCTL_GET_STATUS, IntPtr.Zero, 0, outBuf, (uint)BUF_SIZE, out uint ret, IntPtr.Zero);
                        if (!ok)
                        {
                            win32Error = Marshal.GetLastWin32Error();
                            errorMessage = "DeviceIoControl failed";
                            return false;
                        }

                        if (ret == 0)
                        {
                            status = string.Empty;
                            return true;
                        }

                        // Приводим к строке ANSI без завершающих нулей
                        status = Marshal.PtrToStringAnsi(outBuf, (int)ret)?.TrimEnd('\0');
                        return true;
                    }
                    finally
                    {
                        if (outBuf != IntPtr.Zero) Marshal.FreeHGlobal(outBuf);
                    }
                }
            }
            catch (Exception ex)
            {
                win32Error = Marshal.GetLastWin32Error();
                errorMessage = ex.Message;
                return false;
            }
        }
    }
}
