<Window x:Class="Wrapper111.Gui.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Wrapper111" Height="200" Width="400">
	<Grid Margin="10">
		<StackPanel>
			<CheckBox IsChecked="{Binding ShowWatermark, Mode=TwoWay}" Content="{Binding Path=(local:ResourcesHelper.Get), Converter={x:Null}}" x:Name="WatermarkCheck" Margin="0,0,0,10" />
			<Button Content="{Binding ApplyCommand, Converter={x:Null}}" Width="100" Command="{Binding ApplyCommand}" />
			<Button Content="{Binding GetStatusCommand, Converter={x:Null}}" Width="100" Margin="5,0,0,0" Command="{Binding GetStatusCommand}" />
			<Button Content="{Binding GenerateLogCommand, Converter={x:Null}}" Width="150" Margin="0,10,0,0" Command="{Binding GenerateLogCommand}" />
			<Button Content="{Binding OpenLogCommand, Converter={x:Null}}" Width="100" Margin="5,10,0,0" Command="{Binding OpenLogCommand}" />
			<TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" />
		</StackPanel>
	</Grid>
</Window>