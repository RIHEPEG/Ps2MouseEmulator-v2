using Microsoft.VisualStudio.TestTools.UnitTesting;
using System.Threading.Tasks;

namespace Wrapper111.Tests
{
    [TestClass]
    public class MainWindowViewModelTests
    {
        class FakeDriverClient : Wrapper111.Gui.IDriverClient
        {
            public bool NextSetResult = true;
            public (bool ok, string status, int winErr, string errMsg) NextGetResult = (true, "OK", 0, null);

            public Task<(bool ok, int win32Error, string errorMessage)> TrySetWatermarkAsync(bool enable, System.Threading.CancellationToken cancellationToken = default)
            {
                return Task.FromResult((NextSetResult, 0, NextSetResult ? null : "failed"));
            }

            public Task<(bool ok, string status, int win32Error, string errorMessage)> TryGetStatusAsync(System.Threading.CancellationToken cancellationToken = default)
            {
                return Task.FromResult(NextGetResult);
            }
        }

        [TestMethod]
        public async Task ApplySetsStatusOnSuccess()
        {
            var fake = new FakeDriverClient();
            var vm = new Wrapper111.Gui.MainWindowViewModel(fake);
            vm.ShowWatermark = true;
            await (vm.ApplyCommand.Execute(null) as Task ?? Task.CompletedTask);
            Assert.AreEqual(Wrapper111.Gui.ResourcesHelper.Get("Applied"), vm.StatusText);
        }

        [TestMethod]
        public async Task GetStatusDisplaysStatus()
        {
            var fake = new FakeDriverClient();
            fake.NextGetResult = (true, "Watermark=1", 0, null);
            var vm = new Wrapper111.Gui.MainWindowViewModel(fake);
            await (vm.GetStatusCommand.Execute(null) as Task ?? Task.CompletedTask);
            Assert.IsTrue(vm.StatusText.Contains("Watermark=1"));
        }
    }
}
