<Window x:Class="Wrapper111.Gui.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Wrapper111" Height="200" Width="400">
	<Grid Margin="10">
		<StackPanel>
			<CheckBox x:Name="WatermarkCheck" IsChecked="{Binding ShowWatermark, Mode=TwoWay}" Margin="0,0,0,10" />
			<Button x:Name="ApplyBtn" Width="100" Command="{Binding ApplyCommand}" />
			<Button x:Name="GetStatusBtn" Width="100" Margin="5,0,0,0" Command="{Binding GetStatusCommand}" />
			<Button x:Name="GenLogBtn" Width="150" Margin="0,10,0,0" Command="{Binding GenerateLogCommand}" />
			<Button x:Name="OpenLogBtn" Width="100" Margin="5,10,0,0" Command="{Binding OpenLogCommand}" />
			<TextBlock x:Name="StatusText" Text="{Binding StatusText}" Margin="0,10,0,0" />
		</StackPanel>
	</Grid>
</Window>
